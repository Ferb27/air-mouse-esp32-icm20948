	(text "1. POWER: Adjust MT3608 trimpot to exactly 5.0V output before installing ESP32."
	(at 265 200 0)
	(effects
		(font
			(size 1.27 1.27)
		)
	)
	(uuid "0e0353ec-03ca-4214-b2a0-269cacde79ec")
)
	(text "2. CHARGING: Keep SW1 OFF during USB-C charging via TP4056 to protect load."
	(at 265 207 0)
	(effects
		(font
			(size 1.27 1.27)
		)
	)
	(uuid "d287f912-10dc-4172-8683-f12fc0473f3c")
)
	(text "3. SENSOR VOLTAGE: WCMCU-20948 VCC & I2C logic operates STRICTLY at 1.8V."
	(at 265 214 0)
	(effects
		(font
			(size 1.27 1.27)
		)
	)
	(uuid "fbc9a82f-8bd4-4f16-b364-a93be80eced5")
)
	(text "4. I2C CONFIG: WCMCU NCS tied to 1.8V locks I2C. AD0 tied to GND sets addr 0x68."
	(at 265 221 0)
	(effects
		(font
			(size 1.27 1.27)
		)
	)
	(uuid "0ed29f08-b887-45ea-b942-86d934d8e674")
)
	(text "5. INTERRUPT: IMU INT is routed to TP5 (reserved for firmware motion wake-up)."
	(at 265 228 0)
	(effects
		(font
			(size 1.27 1.27)
		)
	)
