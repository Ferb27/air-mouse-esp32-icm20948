  "battery_steps": [
    {
      "n": 1,
      "title": "Đo pin khi tách khỏi mạch",
      "body": "**Đo pin khi tách khỏi mạch:** DC tại giắc pin, khoảng 3.0–4.2V. Ngoài dải, 0V hoặc pack hỏng/phồng → dừng; không kích/bypass bảo vệ."
    },
    {
      "n": 2,
      "title": "Xác nhận cực tại mặt giắc",
      "body": "**Xác nhận cực tại mặt giắc:** que đỏ ở hốc ghép J1+, đen hốc J1− phải hiện điện áp dương bằng bước 1. Đảo/không rõ/giắc sai → dừng, xử lý §3.13.3."
    },
    {
      "n": 3,
      "title": "Đặt trạng thái trước ghép",
      "body": "**Đặt trạng thái trước ghép:** SW1 OFF, J5V cắm đúng +/−; với mạch không điện, đo SW1 hở OUT+–COM và kiểm không chập 5V–GND như §3.8. Còn nguồn khác hoặc không ngắt được → dừng."
    },
    {
      "n": 4,
      "title": "Ghép pin",
      "body": "**Ghép pin:** sau ghép đo B+–B- bằng pin bước 1, đúng dấu; lệch rõ, nóng/mùi hoặc tia lửa bất thường → ngắt nếu an toàn và dừng."
    },
    {
      "n": 5,
      "title": "Đo OUT+–OUT-",
      "body": "**Đo OUT+–OUT-:** gần bằng B+–B- khi chưa tải; đo V_SYS gần 0V sau tụ xả. OUT=0, áp sai dấu, sụt bất thường → dừng kiểm bảo vệ, không bypass."
    },
    {
      "n": 6,
      "title": "Bật SW1",
      "body": "**Bật SW1:** đo V_SYS so OUT- gần OUT, trong dải thiết kế 3.0–4.2V; sụt/reset/nóng → OFF và dừng. Không thử xả thêm pin yếu để đạt phép này."
    },
    {
      "n": 7,
      "title": "Đo VIN ESP32",
      "body": "**Đo VIN ESP32:** 4.9–5.1V [A] §5.1/[N] §1; ngoài khoảng/dao động rõ → OFF, không chỉnh bừa khi tải đang có lỗi."
    },
    {
      "n": 8,
      "title": "Đo 3V3 tại ESP32/TP3 và IMU VCC",
      "body": "**Đo 3V3 tại ESP32/TP3 và IMU VCC:** 3.25–3.35V theo tiêu chí [N] §1; sai/chạm que nguy hiểm → OFF, kiểm lại."
    },
    {
      "n": 9,
      "title": "Đo BAT_SENSE tại GPIO34",
      "body": "**Đo BAT_SENSE tại GPIO34:** khoảng 0.5×V_SYS; tỷ số 0.495–0.505 từ R2/R3 1% [B], cộng sai số đo. Sai tỷ số/tiến gần điện áp pin thô → OFF, không tiếp tục để bảo vệ ADC."
    },
    {
      "n": 10,
      "title": "Quan sát khởi động và nhiệt",
      "body": "**Quan sát khởi động và nhiệt:** kiểm LED/hành vi chương trình thử đã biết; ưu tiên nhiệt kế đo TP4056, MT3608 và vỏ pin, ghi số thật. Chỉ chạm nhẹ phần vỏ còn nguyên/không dẫn điện khi không có nhiệt kế; tay không cho giá trị °C. Reset/nóng bất thường/phồng/mùi → OFF, không cắm USB để xem log khi J5V còn ghép."
    },
    {
      "n": 11,
      "title": "Chạy đầu 5 phút có người theo dõi",
      "body": "**Chạy đầu 5 phút có người theo dõi:** đo lại VIN/3V3/V_SYS và nhiệt đầu/cuối, ghi reset/sụt áp. Mốc 5 phút là đề xuất [P2] §3.13.4, chưa chứng minh thời lượng/độ bền; lỗi → OFF và dừng."
    },
    {
      "n": 12,
      "title": "Thử sạc riêng sau khi đọc §3.9.2",
      "body": "**Thử sạc riêng sau khi đọc §3.9.2:** SW1 OFF, J5V rút, USB ESP32 rút; đo dòng pin nối tiếp và B+–B- theo §3.4.4, hướng đến 4.2V danh định [T] trong giới hạn pack. Theo dõi sát 5–10 phút đầu và suốt lần sạc; nóng/phồng/mùi/áp hoặc dòng vượt mức đã biết → rút USB sạc và xử lý §3.2."
    }
  ],
